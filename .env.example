# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_URL="mysql://root:@localhost:3306/qa_dms_db"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key"
JWT_ACCESS_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_REFRESH_EXPIRES_IN="1d"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="no-reply@toyoink.id"
SMTP_PASS="your-app-password"
SMTP_FROM="QADMS Notification"

# Frontend URL (for email links)
APP_FRONTEND_URL="http://localhost:5173"

# Google Drive Configuration (for Document Management)
GOOGLE_DRIVE_CREDENTIALS_PATH="./config/google-credentials.json"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id_here"
APP_BASE_URL="http://localhost:3000"

